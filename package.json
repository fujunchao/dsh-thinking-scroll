{
  "name": "dsh-thinking-scroll",
  "version": "0.1.0",
  "description": "Cap expanded reasoning blocks with a scrollable window in the DeepSeek Harness web chat",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "check": "node --check lib/client.js && node --input-type=module --check < lib/index.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujunchao/dsh-thinking-scroll.git"
  },
  "bugs": {
    "url": "https://github.com/fujunchao/dsh-thinking-scroll/issues"
  },
  "homepage": "https://github.com/fujunchao/dsh-thinking-scroll#readme"
}
